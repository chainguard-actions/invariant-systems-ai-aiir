        },
        {
          "command": "aiir.healthCheck",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.hubEvidencePack",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && aiir.canUseCompliance"
        },
        {
          "command": "aiir.hubLatestReport",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && aiir.canRemoteSync"
        },
        {
          "command": "aiir.hubRunAttestation",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && aiir.canRemoteSync"
        },
        {
          "command": "aiir.hubStatus",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed"
        },
        {
          "command": "aiir.hubVerifyReceipt",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && aiir.canRemoteSync"
        },
        {
          "command": "aiir.initializeRepo",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.generateWithProvenance",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.openHubDashboard",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && aiir.hubConnected"
        },
        {
          "command": "aiir.hubBilling",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.reportBug"
        },
        {
          "command": "aiir.configureMcpServer",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.installSigstoreSupport",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.signUpForHub",
          "when": "workspaceFolderCount > 0 && aiir.networkAllowed && !aiir.canRemoteSync"
        },
        {
          "command": "aiir.controlPanel",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.createWorkspacePolicy",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.openPolicyFile",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.editPolicyTargets",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.toggleCurrentPolicyTarget",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.viewReceipt",
          "when": "false"
        },
        {
          "command": "aiir.previewReceiptSummary",
          "when": "false"
        },
        {
          "command": "aiir.verifySelection",
          "when": "false"
        },
        {
          "command": "aiir.verifyCbor",
          "when": "false"
        },
        {
          "command": "aiir.verifySigstore",
          "when": "false"
        },
        {
          "command": "aiir.openSigningGuide",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.reviewReceipt",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.viewReviewHistory",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.recordException",
          "when": "workspaceFolderCount > 0 && aiir.regulatedMode && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.exportEvidencePack",
          "when": "workspaceFolderCount > 0 && aiir.canUseCompliance && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.manageRepositories",
          "when": "workspaceFolderCount > 0 && aiir.canUseSharedRepositories && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.switchRepository",
          "when": "workspaceFolderCount > 1 && aiir.multipleAccessibleRepositories"
        },
        {
          "command": "aiir.purgeProvenanceQueue",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "aiirGettingStarted",
        "title": "Get Started With AIIR",
        "description": "Record the current commit, review the result, and turn on lower-friction follow-ups only when you want them.",
        "steps": [
          {
            "id": "overview",
            "title": "Check the current commit",
            "description": "Start with the commit status view when you want AIIR to explain what the current repository needs. If the CLI or local setup is missing, AIIR can route you through it from there.\n\n[Open commit status](command:aiir.readinessCheck)",
            "media": {
              "markdown": "media/walkthrough-overview.md"
            },
            "completionEvents": [
              "onCommand:aiir.readinessCheck"
            ]
          },
          {
            "id": "generateReceipt",
            "title": "Record this commit",
            "description": "Use the default Record Commit Activity action. AIIR prefers deterministic provenance when an active file supports it, falls back automatically when needed, and completes the missing setup path when the repository is not ready yet.\n\n[Record commit activity](command:aiir.generatePreferred)",
            "media": {
              "markdown": "media/walkthrough-overview.md"
            },
            "completionEvents": [
              "onCommand:aiir.generatePreferred"
            ]
          },
          {
            "id": "reviewSummary",
            "title": "Review or share the result",
            "description": "After recording a commit, open the summary, copy the PR-ready handoff, or verify receipts in place from the same AIIR shell.\n\n[Open the receipt summary](command:aiir.showSummary)\n[Copy the latest receipt summary](command:aiir.copyReceiptSummary)\n[Verify all receipts](command:aiir.verifyAll)",
            "media": {
              "markdown": "media/walkthrough-overview.md"
            },
            "completionEvents": [
              "onCommand:aiir.showSummary",
              "onCommand:aiir.copyReceiptSummary",
              "onCommand:aiir.verifyAll"
            ]
          },
          {
            "id": "enableAutomation",
            "title": "Optional: lower-friction follow-ups",
            "description": "When you want repeat work to fade into the background, turn on managed auto-receipting or open the health check. These are optional follow-ups, not required for the first commit.\n\n[Enable auto-receipting](command:aiir.enableAutoReceipting)\n[Run a health check](command:aiir.healthCheck)",
            "media": {
              "markdown": "media/walkthrough-hardening.md"
            },
            "completionEvents": [
              "onCommand:aiir.enableAutoReceipting",
              "onCommand:aiir.healthCheck"
            ]
          },
          {
            "id": "copilotChat",
            "title": "Ask @aiir in Copilot Chat",
            "description": "Type `@aiir` in Copilot Chat to generate receipts, verify commits, explain AI signals, or check policy compliance — without leaving the conversation.\n\n[Open Copilot Chat](command:workbench.action.chat.open)",
            "media": {
              "markdown": "media/walkthrough-overview.md"
            },
            "completionEvents": [
              "onChatParticipantUsed:aiir.chat"
            ]
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "aiir-receipt",
        "aliases": [
          "AIIR Receipt"
        ],
        "extensions": [
          ".aiir.json"
        ]
      }
    ],
    "configuration": {
      "title": "AIIR",
      "properties": {
        "aiir.cliPath": {
          "type": "string",
          "default": "aiir",
          "order": 1,
          "description": "Path to the AIIR CLI executable used by the VS Code extension when generating receipts."
        },
        "aiir.agentModelHint": {
          "type": "string",
          "default": "",
          "order": 2,
          "description": "Optional declared model class to write into local receipt agent attestation when generating receipts from VS Code, for example 'claude-sonnet-4' or 'gpt-5'."
        },
        "aiir.showAdvancedCommands": {
          "type": "boolean",
          "default": false,
          "order": 6,
          "description": "Show advanced operator commands such as control panel, security posture, deployment presets, policy editing, and Hub plans directly in the command palette. Recommended off for the default single-seat workflow."
        },
        "aiir.autoReceiptArgs": {
          "type": "array",
          "default": [
            "--pretty"
          ],
          "items": {
            "type": "string"
          },
          "order": 3,
          "description": "Arguments passed to the managed AIIR post-commit hook when auto-receipting is enabled."
        },
        "aiir.commitExplorerLimit": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "order": 4,
          "description": "Number of recent commits to show in the Coverage view."
        },
        "aiir.listener.enabled": {
          "type": "boolean",
          "default": false,
          "order": 5,
          "description": "Enable passive AI edit tracking. Off by default. When active, AIIR records file-level provenance in .aiir/editor_provenance.jsonl while active AI coding tools are editing this workspace."
        },
        "aiir.aiBlame.enabled": {
          "type": "boolean",
          "default": false,
          "order": 6,
          "description": "Show inline gutter annotations on lines committed with AI assistance. Cross-references git blame with AIIR receipt data to highlight AI-assisted and bot-authored lines."
        },
        "aiir.provenanceRetainPrompts": {
          "type": "boolean",
          "default": false,
          "order": 7,
          "description": "WARNING: when enabled, provable-mode provenance records include raw prompt text, which may contain credentials, proprietary code, or personal data. When disabled (default), only file hashes and operation metadata are stored."
        },
        "aiir.provenanceRetentionDays": {
          "type": "number",
          "default": 0,
          "order": 8,
          "description": "Number of days to retain consumed provenance records before automatic cleanup. 0 means no automatic cleanup."
        },
        "aiir.enforceWorkspaceIsolation": {
          "type": "boolean",
          "default": false,
          "order": 20,
          "description": "Advanced: when true, automatic discovery in multi-root workspaces is limited to aiir.allowedWorkspaceFolders. Single-root workspaces remain accessible by default. Enable this only when you need workspace isolation."
        },
        "aiir.allowedWorkspaceFolders": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "order": 21,
          "description": "Advanced: folder names or absolute paths that AIIR may scan and operate on in the current workspace. In multi-root workspaces with isolation enabled, folders outside this allowlist are ignored."
        },
        "aiir.strictLocalOnly": {
          "type": "boolean",
          "default": true,
          "order": 22,
          "description": "Advanced: disable all Hub and network-backed commands. This is the default local-only posture."
        },
        "aiir.enableHubFeatures": {
          "type": "boolean",
          "default": false,
          "order": 23,
          "description": "Advanced: enable optional AIIR Hub integration features. When false (default), the extension operates in local-only mode."
        },
        "aiir.hubBaseUrl": {
          "type": "string",
          "default": "",
          "order": 24,
          "description": "Advanced: base URL for optional AIIR Hub API calls. Ignored while aiir.strictLocalOnly remains enabled."
        },
        "aiir.hubTenantId": {
          "type": "string",
          "default": "",
          "order": 25,
          "description": "Advanced: tenant ID for optional AIIR Hub requests. Ignored while aiir.strictLocalOnly remains enabled."
        },
        "aiir.hubSignupEndpoint": {
          "type": "string",
          "default": "",
          "order": 26,
          "description": "Advanced: endpoint used for optional AIIR Hub signup flows. Ignored while aiir.strictLocalOnly remains enabled."
        },
        "aiir.regulatedMode": {
          "type": "boolean",
          "default": false,
          "order": 27,
          "description": "Advanced: when enabled, AIIR treats the repository as covered only when the evidence bar for high-risk regulated workflows is met (policy enabled, HEAD receipted, minimum evidence tier, review attestation)."
        },
        "aiir.injectTrailers": {
          "type": "boolean",
          "default": false,
          "order": 28,
          "description": "Advanced: when enabled, receipt generation and auto-receipting append AIIR trailers (AIIR-Receipt, AIIR-AI) to the last commit message via git commit --amend. Note: this rewrites local history."
        },
        "aiir.lockPreset": {
          "type": "string",
          "default": "",
          "order": 29,
          "description": "Advanced: lock the workspace to a named deployment preset. Individual settings covered by the preset cannot be changed until aiir.lockPreset is cleared."
        },
        "aiir.listener.autoSave": {
          "type": "boolean",
          "default": true,
          "order": 30,
          "description": "Advanced: automatically flush passive listener captures to the provenance queue. When false, captures are held in memory until a manual save or commit."
        },
        "aiir.listener.debounceMs": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "order": 31,
          "description": "Advanced: milliseconds of quiet time after the last edit before the passive listener captures a provenance snapshot."
        },
        "aiir.listener.excludePatterns": {
          "type": "array",
          "default": [
            "**/.aiir/**",
            "**/node_modules/**",
            "**/.git/**"
          ],
          "items": {
            "type": "string"
          },
          "order": 32,
          "description": "Advanced: glob patterns that passive AI edit tracking should ignore."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "marketplace:sync": "node ./scripts/update-marketplace-packet.js",
    "test": "npm run compile && node --test test/*.test.js",
    "test:extension-host": "npm run compile && node ./test/extension-host/run.js",
    "test:coverage:threat": "node ./scripts/check-threat-coverage.js",
    "test:mutations:threat": "node ./scripts/run-threat-mutations.js",
    "package": "npm run compile && npm run marketplace:sync && vsce package",
    "publish:marketplace": "npm run compile && npm run marketplace:sync && vsce publish",
    "package:pre-release": "npm run compile && npm run marketplace:sync && vsce package --pre-release",
    "publish:marketplace:pre-release": "npm run compile && npm run marketplace:sync && vsce publish --pre-release",
    "lint": "eslint src test scripts --ext .ts,.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "cheerio": "1.0.0-rc.12",
    "eslint": "^8.57.1",
    "mocha": "^11.1.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces, AIIR disables CLI execution, hook management, and file-writing operations. Receipt viewing and verification remain available."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "AIIR requires local git repositories and filesystem access."
    }
  }
}
