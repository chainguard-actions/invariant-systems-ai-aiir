    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiir",
          "title": "AIIR",
          "icon": "media/aiir-shield.svg"
        }
      ]
    },
    "views": {
      "aiir": [
        {
          "id": "aiir.homeView",
          "name": "Status",
          "icon": "media/aiir-shield.svg",
          "contextualTitle": "AIIR Status"
        },
        {
          "id": "aiir.commitExplorer",
          "name": "Coverage",
          "icon": "media/aiir-shield.svg",
          "contextualTitle": "AIIR Coverage",
          "visibility": "collapsed"
        },
        {
          "id": "aiir.receiptExplorer",
          "name": "Receipts",
          "icon": "media/aiir-shield.svg",
          "contextualTitle": "AIIR",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiir.commitExplorer",
        "contents": "No commit coverage yet.\n\nOpen a git repository to see which commits already have AIIR records and which still need one.\n\n[$(checklist) Open commit status](command:aiir.readinessCheck)\n[$(milestone) Open getting started](command:aiir.openWalkthrough)"
      },
      {
        "view": "aiir.receiptExplorer",
        "contents": "No receipts found yet.\n\nStart with the default path:\n\n[$(checklist) Open commit status](command:aiir.readinessCheck)\n[$(milestone) Open getting started](command:aiir.openWalkthrough)\n\nNeed the CLI first? [$(cloud-download) Install CLI](command:aiir.installCliNow)."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aiir.refreshCommitExplorer",
          "when": "view == aiir.commitExplorer",
          "group": "navigation"
        },
        {
          "command": "aiir.toggleListener",
          "when": "view == aiir.commitExplorer",
          "group": "navigation"
        },
        {
          "command": "aiir.generateMissingReceipts",
          "when": "view == aiir.commitExplorer && aiir.showAdvancedCommands",
          "group": "navigation"
        },
        {
          "command": "aiir.readinessCheck",
          "when": "view == aiir.homeView",
          "group": "navigation"
        },
        {
          "command": "aiir.switchRepository",
          "when": "view == aiir.homeView && aiir.multipleAccessibleRepositories",
          "group": "navigation"
        },
        {
          "command": "aiir.switchRepository",
          "when": "view == aiir.commitExplorer && aiir.multipleAccessibleRepositories",
          "group": "navigation"
        },
        {
          "command": "aiir.generateWithProvenance",
          "when": "view == aiir.receiptExplorer",
          "group": "navigation"
        },
        {
          "command": "aiir.refresh",
          "when": "view == aiir.receiptExplorer",
          "group": "navigation"
        },
        {
          "command": "aiir.showSummary",
          "when": "view == aiir.receiptExplorer",
          "group": "navigation"
        },
        {
          "command": "aiir.manageRepositories",
          "when": "view == aiir.receiptExplorer && aiir.canUseSharedRepositories && aiir.showAdvancedCommands",
          "group": "navigation"
        },
        {
          "command": "aiir.switchRepository",
          "when": "view == aiir.receiptExplorer && aiir.multipleAccessibleRepositories",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "aiir.generatePreferred",
          "when": "scmProvider == git && aiir.headReceiptMissing && aiir.cliAvailable",
          "group": "4_aiir@1"
        },
        {
          "command": "aiir.readinessCheck",
          "when": "scmProvider == git && aiir.headReceiptMissing && !aiir.cliAvailable",
          "group": "4_aiir@2"
        },
        {
          "command": "aiir.enableAutoReceipting",
          "when": "scmProvider == git && aiir.headReceiptMissing && aiir.cliAvailable && aiir.activeAIToolDetected && !aiir.autoReceiptingManaged",
          "group": "4_aiir@3"
        },
        {
          "command": "aiir.switchRepository",
          "when": "scmProvider == git && aiir.multipleAccessibleRepositories",
          "group": "4_aiir@4"
        }
      ],
      "explorer/context": [
        {
          "command": "aiir.verifyFile",
          "when": "resourceExtname == .json",
          "group": "aiir@1"
        }
      ],
      "editor/context": [
        {
          "command": "aiir.verifySelection",
          "when": "editorHasSelection",
          "group": "aiir@1"
        }
      ],
      "editor/title": [
        {
          "command": "aiir.verifyFile",
          "when": "resourceFilename =~ /\\.aiir\\.json$/",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aiir.viewReceipt",
          "when": "view == aiir.receiptExplorer && viewItem =~ /^receipt-(valid|invalid)$/",
          "group": "inline@1"
        },
        {
          "command": "aiir.verifyFile",
          "when": "view == aiir.receiptExplorer && viewItem =~ /^receipt-(valid|invalid)$/",
          "group": "inline@2"
        },
        {
          "command": "aiir.openReceiptSource",
          "when": "view == aiir.receiptExplorer && viewItem =~ /^receipt-(valid|invalid)$/",
          "group": "navigation@1"
        },
        {
          "command": "aiir.copyReceiptSummary",
          "when": "view == aiir.receiptExplorer && viewItem =~ /^receipt-(valid|invalid)$/",
          "group": "navigation@2"
        },
        {
          "command": "aiir.repairReceipt",
          "when": "view == aiir.receiptExplorer && viewItem == receipt-invalid",
          "group": "inline@3"
        },
        {
          "command": "aiir.repairReceipt",
          "when": "view == aiir.receiptExplorer && viewItem == receipt-invalid",
          "group": "navigation@2.5"
        },
        {
          "command": "aiir.openTreeFile",
          "when": "view == aiir.receiptExplorer && viewItem == receipt-file",
          "group": "inline@1"
        },
        {
          "command": "aiir.reviewReceipt",
          "when": "view == aiir.receiptExplorer && viewItem =~ /^receipt-(valid|invalid)$/ && aiir.showAdvancedCommands",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "aiir.readinessCheck"
        },
        {
          "command": "aiir.generatePreferred",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.generateReceipt",
          "when": "false"
        },
        {
          "command": "aiir.installCliNow"
        },
        {
          "command": "aiir.copyCliInstallCommand",
          "when": "false"
        },
        {
          "command": "aiir.openCliInstallTerminal",
          "when": "false"
        },
        {
          "command": "aiir.copyReceiptSummary",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.verifyAll",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "aiir.repairReceipt",
          "when": "false"
        },
        {
          "command": "aiir.securityPosture",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.rolloutPresets",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.advancedSettings",
          "when": "workspaceFolderCount > 0 && aiir.showAdvancedCommands"
        },
        {
          "command": "aiir.openReceiptSource",
          "when": "false"
        },
        {
          "command": "aiir.openTreeFile",
          "when": "false"
        },
        {
