{
  "name": "aiir",
  "displayName": "AIIR",
  "description": "Local-first AI integrity receipts for git commits with active tool context.",
  "version": "0.4.1",
  "publisher": "invariant-systems",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/invariant-systems-ai/aiir"
  },
  "homepage": "https://invariantsystems.io",
  "bugs": {
    "url": "https://github.com/invariant-systems-ai/aiir/issues"
  },
  "badges": [
    {
      "url": "https://img.shields.io/github/license/invariant-systems-ai/aiir",
      "href": "https://github.com/invariant-systems-ai/aiir/blob/main/LICENSE",
      "description": "License"
    },
    {
      "url": "https://img.shields.io/github/v/release/invariant-systems-ai/aiir",
      "href": "https://github.com/invariant-systems-ai/aiir/releases",
      "description": "Latest Release"
    }
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionPack": [
    "github.copilot-chat"
  ],
  "categories": [
    "AI",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "aiir",
    "ai",
    "receipts",
    "verification",
    "provenance",
    "provable",
    "integrity",
    "compliance",
    "audit",
    "governance",
    "git",
    "sigstore",
    "vscode",
    "copilot",
    "claude",
    "chatgpt",
    "eu-ai-act"
  ],
  "activationEvents": [
    "workspaceContains:**/*.aiir.json",
    "workspaceContains:**/.receipts/*.json",
    "workspaceContains:**/.aiir/**",
    "onChatParticipant:aiir.chat"
  ],
  "main": "./out/extension.js",
  "chatParticipantDetection": {
    "participants": [
      {
        "id": "aiir.chat",
        "disambiguationCategory": "ai_integrity",
        "keywords": [
          "aiir",
          "receipt",
          "ai integrity",
          "provenance",
          "ai audit",
          "commit receipt"
        ]
      }
    ]
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "aiir.chat",
        "fullName": "AIIR",
        "name": "aiir",
        "description": "AI integrity receipts — generate, verify, explain, and check policy for git commit receipts.",
        "isSticky": false,
        "commands": [
          {
            "name": "receipt",
            "description": "Generate a receipt for the current or specified commit"
          },
          {
            "name": "verify",
            "description": "Verify an AIIR receipt file"
          },
          {
            "name": "stats",
            "description": "Show receipt statistics for the repository"
          },
          {
            "name": "explain",
            "description": "Explain what an AIIR receipt proves"
          },
          {
            "name": "policy",
            "description": "Check repository policy compliance"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "aiir_receipt",
        "tags": [
          "aiir",
          "receipt",
          "ai",
          "integrity",
          "provenance"
        ],
        "displayName": "Generate AIIR Receipt",
        "modelDescription": "Generate a tamper-evident receipt for a git commit that records AI involvement signals. Call this when the user wants to create proof of AI tool usage for a commit.",
        "icon": "$(sparkle)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "description": "Specific commit SHA to receipt. Default: HEAD."
            },
            "range": {
              "type": "string",
              "description": "Commit range to receipt (e.g., 'HEAD~3..HEAD')."
            },
            "pretty": {
              "type": "boolean",
              "description": "Return human-readable summary instead of raw JSON."
            }
          }
        }
      },
      {
        "name": "aiir_verify",
        "tags": [
          "aiir",
          "verify",
          "integrity",
          "receipt"
        ],
        "displayName": "Verify AIIR Receipt",
        "modelDescription": "Verify the integrity of an AIIR receipt file. Checks that content_hash and receipt_id are valid — any modification invalidates the receipt.",
        "icon": "$(verified)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Relative path to the receipt JSON file to verify. Omit to verify the latest active receipt."
            }
          }
        }
      },
      {
        "name": "aiir_stats",
        "tags": [
          "aiir",
          "statistics",
          "receipt",
          "coverage"
        ],
        "displayName": "AIIR Receipt Statistics",
        "modelDescription": "Show statistics for the AIIR receipt ledger. Returns receipt count, AI-authored percentage, unique authors, and date range.",
        "icon": "$(graph)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "aiir_explain",
        "tags": [
          "aiir",
          "explain",
          "receipt",
          "audit"
        ],
        "displayName": "Explain AIIR Receipt",
        "modelDescription": "Explain what an AIIR receipt proves about a commit in plain language. Useful for understanding AI involvement signals and evidence tiers.",
        "icon": "$(info)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "description": "Relative path to a receipt file to explain. Omit to explain the latest receipt."
            }
          }
        }
      },
      {
        "name": "aiir_policy_check",
        "tags": [
          "aiir",
          "policy",
          "compliance",
          "governance"
        ],
        "displayName": "AIIR Policy Check",
        "modelDescription": "Check whether the current repository meets its declared AIIR policy requirements. Returns pass/fail status with details on any gaps.",
        "icon": "$(shield)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
