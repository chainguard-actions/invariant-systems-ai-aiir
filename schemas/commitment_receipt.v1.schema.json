{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariantsystems.io/schemas/aiir/commitment_receipt.v1.schema.json",
  "title": "AIIR Commitment Receipt v1",
  "type": "object",
  "required": [
    "type",
    "schema",
    "version",
    "subject",
    "statement",
    "artifacts",
    "provenance",
    "receipt_id",
    "content_hash",
    "timestamp"
  ],
  "properties": {
    "type": {
      "const": "aiir.commitment_receipt"
    },
    "schema": {
      "const": "aiir/commitment_receipt.v1"
    },
    "version": {
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "statement": {
      "$ref": "#/$defs/Statement"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Artifact"
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^c1-[0-9a-f]{32}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "Subject": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Statement": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "DirectoryMember": {
      "type": "object",
      "required": ["path", "type"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["file", "directory"]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "required": ["type", "ref", "digest", "role"],
      "properties": {
        "type": {
          "enum": ["file", "directory", "digest"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirectoryMember"
          }
        }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "required": ["tool", "generator"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}