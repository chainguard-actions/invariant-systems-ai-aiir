{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://invariantsystems.io/schemas/aiir/research_evidence_receipt.v0.1.schema.json",
  "title": "AIIR Research-Evidence Receipt Profile v0.1",
  "description": "Draft JSON Schema for AIIR research-evidence receipts. This verify-only profile binds one governed research claim to declared evidence artifacts, verifier paths, and disclosure metadata.",
  "type": "object",
  "required": [
    "contract_version",
    "record_id",
    "timestamp",
    "subject",
    "claim",
    "evidence",
    "governance",
    "proof"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "aiir/research_evidence_receipt.v0.1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^r1-[0-9a-f]{32}$",
      "description": "Content-addressed record identifier derived from the research-evidence record core. Parallel to the AIIR commit ('g1-') and agent ('a1-') prefixes."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "required": ["kind", "repo", "program_id", "claim_id", "title"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "research_claim"
        },
        "repo": {
          "type": "string",
          "maxLength": 200
        },
        "program_id": {
          "type": "string",
          "maxLength": 120
        },
        "claim_id": {
          "type": "string",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "claim": {
      "type": "object",
      "required": ["status", "summary", "non_claims", "last_reviewed"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "hypothesis",
            "computational_evidence",
            "proof_sketch",
            "verified",
            "published",
            "disputed",
            "retracted"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 5000
        },
        "non_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "last_reviewed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["artifacts", "verifiers"],
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/researchArtifact"
          }
        },
        "verifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/researchArtifact"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": ["public_safe", "ip_sensitive", "disclosure_tier", "next_gate"],
      "additionalProperties": false,
      "properties": {
        "public_safe": {
          "type": "boolean"
        },
        "ip_sensitive": {
          "type": "boolean"
        },
        "disclosure_tier": {
          "type": "string",
          "enum": ["public", "internal", "restricted", "embargoed"]
        },
        "next_gate": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "proof": {
      "type": "object",
      "required": ["canonicalization", "content_hash"],
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "const": "aiir-canon-0"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional namespaced extension fields. Extensions are excluded from the record core in v0.1 and therefore do not affect content_hash or record_id."
    }
  },
  "$defs": {
    "researchArtifact": {
      "type": "object",
      "required": ["type", "ref", "digest"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["file", "directory", "url", "other"]
        },
        "ref": {
          "type": "string",
          "maxLength": 500
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "type": "string",
          "maxLength": 60
        }
      }
    }
  }
}