  "description": "Machine-readable registry of AIIR spec versions, conformance levels, test vectors, implementations, and extensions. Updated on each spec release.",
  "last_updated": "2026-06-12",
  "spec": {
    "name": "AIIR Commit Receipt Specification",
    "version": "2.0.0",
    "schema_id": "aiir/commit_receipt.v2",
    "status": "Stable",
    "url": "https://github.com/invariant-systems-ai/aiir/blob/main/SPEC.md",
