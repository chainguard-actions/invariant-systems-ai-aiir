      "generated_at": "2026-03-09T00:00:00Z",
      "purpose": "Canonical JSON encoding and hash determinism. Conforming implementations must compute identical content_hash and receipt_id for all 25 inputs."
    },
    {
      "file": "schemas/cbor_test_vectors.json",
