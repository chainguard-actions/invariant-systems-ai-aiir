    },
    {
      "file": "schemas/adversarial_conformance_vectors.json",
      "url": "https://github.com/invariant-systems-ai/aiir/blob/main/schemas/adversarial_conformance_vectors.json",
      "format": "JSON",
      "count": 15,
      "spec_version": "2.0.0",
      "generated_by": "schemas/test-vectors/generate_hardened_vectors.py",
      "generated_at": "2026-03-25T00:00:00Z",
      "purpose": "Adversarial conformance. Hostile receipts (injection, tampering, bypass, evasion) that third-party verifiers MUST handle correctly."
    },
    {
      "file": "schemas/unicode_evasion_vectors.json",
      "url": "https://github.com/invariant-systems-ai/aiir/blob/main/schemas/unicode_evasion_vectors.json",
      "format": "JSON",
      "count": 8,
      "spec_version": "2.0.0",
      "generated_by": "schemas/test-vectors/generate_hardened_vectors.py",
      "generated_at": "2026-03-25T00:00:00Z",
      "purpose": "Unicode evasion. Homoglyphs, invisible characters, combining marks, and variation selectors that test ensure_ascii canonical encoding."
    },
    {
      "file": "schemas/canonicalization_trap_vectors.json",
      "url": "https://github.com/invariant-systems-ai/aiir/blob/main/schemas/canonicalization_trap_vectors.json",
      "format": "JSON",
      "count": 8,
      "spec_version": "2.0.0",
      "generated_by": "schemas/test-vectors/generate_hardened_vectors.py",
      "generated_at": "2026-03-25T00:00:00Z",
      "purpose": "Canonicalization traps. Edge cases that commonly differ across JSON encoders: key sorting, 0 vs false, null vs absent, control char escaping."
    },
    {
      "file": "schemas/cross_format_vectors.json",
      "url": "https://github.com/invariant-systems-ai/aiir/blob/main/schemas/cross_format_vectors.json",
      "format": "JSON+CBOR",
      "count": 5,
      "spec_version": "2.0.0",
      "generated_by": "schemas/test-vectors/generate_hardened_vectors.py",
      "generated_at": "2026-03-25T00:00:00Z",
      "purpose": "Cross-format determinism. Same receipt in JSON and CBOR must yield the same content_hash."
    },
    {
      "file": "schemas/negative_encoding_vectors.json",
      "url": "https://github.com/invariant-systems-ai/aiir/blob/main/schemas/negative_encoding_vectors.json",
      "format": "JSON",
      "count": 4,
      "spec_version": "2.0.0",
      "generated_by": "schemas/test-vectors/generate_hardened_vectors.py",
      "generated_at": "2026-03-25T00:00:00Z",
      "purpose": "Negative encoding. Shows WRONG canonical JSON alongside CORRECT canonical JSON for known encoder pitfalls."
    },
    {
      "file": "schemas/test_vectors_v2.json",
      "url": "https://github.com/invariant-systems-ai/aiir/blob/main/schemas/test_vectors_v2.json",
      "format": "JSON",
      "count": 4,
      "spec_version": "2.0.0",
      "generated_by": "AIIR dogfood ledger (real deployed receipts), verified 2026-06-12",
      "generated_at": "2026-06-12T00:00:00Z",
      "purpose": "Representative aiir/commit_receipt.v2 conformance vectors: human, merge commit (2 parents), ai_assisted, and bot authorship classes. Each is a real deployed receipt verified byte-exact by the reference verifier (aiir._verify.verify_receipt valid=true). Third-party verifiers implementing v2 MUST pass these vectors."
    }
  ],
